# .env.example - Plantilla de Credenciales y Parametros

# Broker Activo ("moomoo" o "alpaca")
BROKER=moomoo

# Moomoo OpenD (Pasarela local en la PC)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_API_KEY=
MOOMOO_API_SECRET=

# Alpaca Paper Trading (Opcional si usas Alpaca)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram Bot (Observability Channel Only - Outbound)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_MIN_SEVERITY=INFO

# Gestion de Riesgo Profesional
DEMO_CAPITAL=100000.0
RISK_MAX_EXPOSURE=0.02
RISK_MAX_TOTAL=0.10
MIN_RR_RATIO=2.0
MAX_DAILY_LOSS_PCT=2.5
